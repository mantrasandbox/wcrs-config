spring:
  config:
    gateway:
      routes:
        - id: auth-service-routes
          uri: http://auth-services:4001
          predicates:
            - Path=/auth/**
          filters:
            #- StripPrefix=1

        - id: admin-service-routes
          uri: http://admin:9090
          predicates:
            - Path=/admin/**
          filters:
            #- StripPrefix=1

        - id: pgadmin-service-routes
          uri: http://ms_pgadmin:80
          predicates:
            - Path=/pgadmin/**
          filters:
            #- StripPrefix=1

        - id: employee-service-routes
          uri: http://employee:4000
          predicates:
            - Path=/api/v1/employees/**
          filters:
            - StripPrefix=1
